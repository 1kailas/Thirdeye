SARVAM_API_KEY=
# CAMERA_URL=off disables the IP Webcam stream; the Android phone client then supplies photos.
CAMERA_URL=http://100.109.140.21:8080/video
CAMERA_ROTATION=0
VISION_MODEL=gemma4
VISION_FALLBACK_MODEL=glm5.3-flash
STT_MODEL=saaras:v4
TTS_MODEL=bulbul:v4-flash
TTS_VOICE=simran_en_customer
TTS_PACE=0.95
# ml-IN pins Malayalam; unknown auto-detects the spoken language.
LANGUAGE_CODE=unknown
IMAGE_MAX_WIDTH=1280
JPEG_QUALITY=82
# Keep 127.0.0.1 for browser-only use. Any other HOST requires PHONE_TOKEN below.
HOST=127.0.0.1
PORT=8000
# Bearer token for the Android phone client (/api/phone/*). Required when HOST is not localhost.
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
PHONE_TOKEN=
PHONE_DEBUG=1
