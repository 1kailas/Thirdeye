<resources>
    <string name="app_name">DrishtiGuide</string>
    <string name="subtitle">Thirdeye · hands-free visual assistant</string>
    <string name="accessibility_description">സ്ക്രീനിൽ തൊടാതെ ഫോട്ടോ എടുക്കാനും ചോദ്യങ്ങൾ ചോദിക്കാനും ശബ്ദം കൂട്ടുന്ന ബട്ടൺ ഉപയോഗിക്കാം. ദൃഷ്ടിഗൈഡ് സ്ക്രീനിലെ ഉള്ളടക്കം വായിക്കില്ല.</string>
    <string name="notification_channel">thirdeye_trigger</string>
    <string name="notification_channel_name">DrishtiGuide trigger</string>
    <string name="notification_title">ദൃഷ്ടിഗൈഡ് തയ്യാറാണ്</string>
    <string name="notification_text">ഫോട്ടോ എടുക്കാൻ ശബ്ദം കൂട്ടുന്ന ബട്ടൺ ഒന്ന് അമർത്തുക. ചോദ്യം ചോദിക്കാൻ അമർത്തിപ്പിടിക്കുക.</string>
    <string name="notification_stop">നിർത്തുക</string>

    <!-- Hero states -->
    <string name="state_setup">സജ്ജീകരണം പൂർത്തിയാക്കണം</string>
    <string name="state_setup_explain">ശബ്ദം കൂട്ടുന്ന ബട്ടൺ ഉപയോഗിക്കാൻ താഴെയുള്ള സജ്ജീകരണങ്ങൾ പൂർത്തിയാക്കുക.</string>
    <string name="state_ready">തയ്യാറാണ്</string>
    <string name="state_ready_explain">ഫോട്ടോ എടുക്കാൻ ശബ്ദം കൂട്ടുന്ന ബട്ടൺ ഒന്ന് അമർത്തുക. ചോദ്യം ചോദിക്കാൻ അമർത്തിപ്പിടിക്കുക.</string>
    <string name="state_listening">കേൾക്കുന്നു…</string>
    <string name="state_listening_explain">ശബ്ദം കൂട്ടുന്ന ബട്ടൺ അമർത്തിപ്പിടിച്ച് ചോദ്യം പറയുക.</string>
    <string name="state_looking">പരിശോധിക്കുന്നു…</string>
    <string name="state_looking_explain">ഫോട്ടോ എടുത്ത് കമ്പ്യൂട്ടറിലേക്ക് അയയ്ക്കുന്നു.</string>
    <string name="state_speaking">മറുപടി പറയുന്നു…</string>
    <string name="state_speaking_explain">മറുപടി നിർത്താൻ ശബ്ദം കൂട്ടുന്ന ബട്ടൺ അമർത്തുക.</string>
    <string name="state_problem">ഒരു പ്രശ്നമുണ്ടായി</string>
    <string name="state_problem_explain">കൂടുതൽ വിവരങ്ങൾക്ക് താഴെയുള്ള സന്ദേശം നോക്കുക.</string>

